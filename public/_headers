# Response headers for the Cloudflare Workers deploy. Copied into out/ by the
# build, because everything in public/ is, and read from there at deploy time.
#
# Every matching rule contributes, so the /* block below applies to the two
# cached paths as well and only the Cache-Control differs between them.
#
# These replace the rules netlify.toml used to carry, in Cloudflare's syntax.
# Any other static host will want its own equivalent; this file is not portable.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Content-hashed by the build, so the filename changes whenever the bytes do and
# a year-long immutable cache costs nothing.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Optimised by hand via scripts/optimize-media.mjs and not content-hashed, so
# this revalidates rather than going immutable. A replaced photo keeping its
# filename would otherwise stay stale in caches for the full week.
/media/*
  Cache-Control: public, max-age=604800, must-revalidate

# Self-hosted Archivo, built by scripts/build-fonts.mjs. Not content-hashed, so
# it revalidates rather than going immutable, same policy as /media.
/fonts/*
  Cache-Control: public, max-age=604800, must-revalidate
